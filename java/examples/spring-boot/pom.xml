<?xml version="1.0" encoding="UTF-8"?>
<!-- A Spring Boot web application that uses the Observa starter:
     OBSERVA_KEY=sk_… OBSERVA_ENDPOINT=http://localhost:8090 mvn -q spring-boot:run
     then: curl -X POST localhost:8095/bookings -H 'Content-Type: application/json' -d '{"userId":"sdk-test-2","nights":2}' -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath />
    </parent>

    <groupId>example</groupId>
    <artifactId>observa-spring-boot-example</artifactId>
    <version>1.0</version>

    <properties>
        <java.version>17</java.version>
    </properties>

    <!-- The Observa SDK comes from JitPack. -->
    <repositories>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.the1zozz.observa-sdks</groupId>
            <artifactId>observa-spring-boot-starter</artifactId>
            <version>0.3.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
