    "prepack": "npm run build"
  },
  "license": "UNLICENSED",
  "private": false,
  "devDependencies": {
    "typescript": "5.8",
    "vitest": "^5.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the1zozz/observa-sdks.git",
    "directory": "web"
  },
  "homepage": "https://github.com/the1zozz/observa-sdks/tree/main/web"
